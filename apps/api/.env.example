# Use a dedicated, isolated Neon development database. Never use production here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Generate a unique secret with: openssl rand -base64 48
JWT_SECRET=""
JWT_ACCESS_TOKEN_TTL_SECONDS=600
JWT_REFRESH_TOKEN_TTL_DAYS=7
PORT=3000
TZ=UTC
RESERVATION_HOLD_MINUTES=5
# ADR-003: unresolved payments enter manual reconciliation after this deadline.
PAYMENT_RECONCILIATION_TIMEOUT_MINUTES=30
# Optional admin-only movie metadata search/import. Keep this backend secret out of the browser.
TMDB_API_READ_ACCESS_TOKEN=""
